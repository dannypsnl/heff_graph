module heff_graph.algebra
  ( Graph
  , additionOfGraph
  , empty
  , (~>)
  , vertex
  , edge
  , vertices
  , clique
  )

theory Graph g where
  v : Type
  empty : g
  vertex : v -> g
  overlay : g -> g -> g
  connect : g -> g -> g

empty : {g : Type} -> {{m : Graph g}} -> g
empty = m.empty

additionOfGraph : {g : Type}
                -> {{m : Graph g}}
                -> Addition g
additionOfGraph = { add = m.overlay }

infixl ~>
(~>) : {g : Type} -> {{m : Graph g}} -> g -> g -> g
(~>) = m.connect

vertex : {g : Type} -> {{m : Graph g}} -> m.v -> g
vertex x = m.vertex x

edge : {g : Type} -> {{m : Graph g}} -> m.v -> m.v -> g
edge x y = (vertex x) ~> (vertex y)

vertices : {g : Type} -> {{m : Graph g}} -> List m.v -> g
vertices [] = empty
vertices (x :: xs) = m.overlay (vertex x) (vertices xs)

clique : {g : Type}
       -> {{m : Graph g}}
       -> List m.v
       -> g
clique [] = m.empty
clique (x :: xs) = (vertex x) ~> (clique xs)
