module heff_graph.graph
  ( Graph
  , empty
  , overlay
  , connect
  , (<=>)
  , vertex
  , edge
  , vertices
  , clique
  )

-- g refers to the graph type of vertex
-- a is the type itself store
-- theory Vertex g where
--   a : Type

theory Graph g where
  v : Type
  empty : g
  vertex : v -> g
  overlay : g -> g -> g
  connect : g -> g -> g

empty : {g : Type} -> {{m : Graph g}} -> g
empty = m.empty

overlay : {g : Type} -> {{m : Graph g}} -> g -> g -> g
overlay x y = m.overlay x y

instance instanceAdditionGraph : {g : Type} -> {{_ : Graph g}} -> Addition g
instanceAdditionGraph = { add = overlay }

connect : {g : Type} -> {{m : Graph g}} -> g -> g -> g
connect x y = m.connect x y

infixl <=>
(<=>) : {g : Type} -> {{m : Graph g}} -> g -> g -> g
(<=>) = connect

vertex : {g : Type} -> {{m : Graph g}} -> m.v -> g
vertex x = m.vertex x

edge : {g : Type} -> {{m : Graph g}} -> m.v -> m.v -> g
edge x y = connect (vertex x) (vertex y)

vertices : {g : Type} -> {{m : Graph g}} -> List m.v -> g
vertices [] = empty
vertices (x :: xs) = (vertex x) + (vertices xs)

clique : {g : Type} -> {{m : Graph g}} -> List m.v -> g
clique [] = empty
clique (x :: xs) = (vertex x) <=> (vertices xs)
