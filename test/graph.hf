module test.graph

import check
import co
import generator as Gen
import heff_graph.algebra
import heff_graph.graph.relation

-- | A graph built by the theory's operations, of at most `n` of them,
-- | on the vertices 0 to 5 (few, so that the operands share some).
graphOf : Int -> Gen.Generator Relation
graphOf n =
  if n <= 1
  then Gen.oneOf
      (MkNonEmptyList
         (Gen.constant empty)
         [ Gen.map
           (\(i : Int) -> (vertex i : Relation))
           (Gen.int 0 5)
         ])
  else Gen.oneOf
      (MkNonEmptyList
         (graphOf 1)
         [ Gen.map2 (\a b -> a + b) (graphOf (n / 2)) (graphOf (n / 2))
         , Gen.map2 (\a b -> a ~> b) (graphOf (n / 2)) (graphOf (n / 2))
         ])

-- | A graph of a size that grows with the runs.
graph : Gen.Generator Relation
graph = Gen.sized (\n -> graphOf (n / 4))

laws : Test
laws =
  group
    "Graph laws"
    [ property "x + y = y + x" (do
        x <- forAll graph
        y <- forAll graph
        assertEqual (x + y) (y + x))
    , property "x + (y + z) = (x + y) + z" (do
        x <- forAll graph
        y <- forAll graph
        z <- forAll graph
        assertEqual (x + (y + z)) ((x + y) + z))
    , property "x + x = x" (do
        x <- forAll graph
        assertEqual (x + x) x)
    , property "empty ~> x = x" (do
        x <- forAll graph
        assertEqual (empty ~> x) x)
    , property "x ~> empty = x" (do
        x <- forAll graph
        assertEqual (x ~> empty) x)
    , property "x ~> (y ~> z) = (x ~> y) ~> z" (do
        x <- forAll graph
        y <- forAll graph
        z <- forAll graph
        assertEqual (x ~> (y ~> z)) ((x ~> y) ~> z))
    , property "x ~> (y + z) = (x ~> y) + (x ~> z)" (do
        x <- forAll graph
        y <- forAll graph
        z <- forAll graph
        assertEqual (x ~> (y + z)) ((x ~> y) + (x ~> z)))
    , property "(x + y) ~> z = (x ~> z) + (y ~> z)" (do
        x <- forAll graph
        y <- forAll graph
        z <- forAll graph
        assertEqual ((x + y) ~> z) ((x ~> z) + (y ~> z)))
    , property "x ~> y ~> z = (x ~> y) + (x ~> z) + (y ~> z)" (do
        x <- forAll graph
        y <- forAll graph
        z <- forAll graph
        assertEqual (x ~> y ~> z) ((x ~> y) + (x ~> z) + (y ~> z)))
    ]

constructions : Test
constructions =
  group
    "Constructions"
    [ unit
      "edge"
      (assertEqual (edge 1 2 : Relation) (MkRelation [1, 2] [MkPair 1 2]))
    , unit
      "vertices"
      (assertEqual (vertices [3, 1, 2, 1] : Relation) (MkRelation [1, 2, 3] []))
    , unit
      "clique"
      (assertEqual
         (clique [1, 2, 3] : Relation)
         (MkRelation [1, 2, 3] [MkPair 1 2, MkPair 1 3, MkPair 2 3]))
    ]
